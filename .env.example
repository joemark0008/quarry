# Copy to .env and fill in. Never commit .env.

# Docker Postgres (docker-compose.yml). Host port 5434 so it doesn't clash with a local Postgres on 5432.
POSTGRES_USER=quarry
POSTGRES_PASSWORD=quarry
POSTGRES_PORT=5434

# App database (Prisma)
DATABASE_URL=postgresql://quarry:quarry@localhost:5434/quarry

# Test warehouse the agent queries (jaffle_shop, loaded by `npm run warehouse:load`)
WAREHOUSE_URL=postgresql://quarry:quarry@localhost:5434/warehouse

# apps/api port (the upstream backend keeps 5005 while the frontend proxy splits traffic)
PORT=5006

# Auth (better-auth)
BETTER_AUTH_SECRET= # run `openssl rand -base64 32` to generate
# Public URL of the app (auth redirects, trusted origins)
BETTER_AUTH_URL=http://localhost:3000

# LLM providers — set at least one
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# apps/api: GitHub owner/name whose releases the update check compares against (unset: no update check)
# QUARRY_RELEASES_REPOSITORY=
# apps/api: default local project (context files) created for the first user
# QUARRY_DEFAULT_PROJECT_PATH=

# Frontend links (build time). Unset: the UI that would link there is hidden.
# VITE_QUARRY_DOCS_URL=
# VITE_QUARRY_SUPPORT_EMAIL=
# VITE_QUARRY_REPOSITORY_URL=
# VITE_QUARRY_COMMUNITY_URL=
# VITE_QUARRY_NEWSLETTER_SUBSCRIBE_URL=
# VITE_QUARRY_PRIVACY_URL=
