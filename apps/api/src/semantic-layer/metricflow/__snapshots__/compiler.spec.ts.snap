// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`semantic query compiler > compiles example query {"metrics":["average_order_value"],"groupBy":["metric_time__month"]} 1`] = `
"SELECT
  metric_time__month
  , CAST(revenue AS DOUBLE PRECISION) / CAST(NULLIF(orders, 0) AS DOUBLE PRECISION) AS average_order_value
FROM (
  SELECT
    COALESCE(subq_3.metric_time__month, subq_4.metric_time__month) AS metric_time__month
    , MAX(subq_3.revenue) AS revenue
    , MAX(subq_4.orders) AS orders
  FROM (
    SELECT
      metric_time__month
      , SUM(revenue) AS revenue
    FROM (
      SELECT
        DATE_TRUNC('month', order_date) AS metric_time__month
        , amount AS revenue
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_1
    GROUP BY
      metric_time__month
  ) subq_3
  FULL OUTER JOIN (
    SELECT
      metric_time__month
      , SUM(orders) AS orders
    FROM (
      SELECT
        DATE_TRUNC('month', order_date) AS metric_time__month
        , 1 AS orders
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_2
    GROUP BY
      metric_time__month
  ) subq_4
  ON subq_3.metric_time__month = subq_4.metric_time__month
  GROUP BY
    COALESCE(subq_3.metric_time__month, subq_4.metric_time__month)
) subq_5"
`;

exports[`semantic query compiler > compiles example query {"metrics":["completed_revenue","revenue"],"groupBy":["metric_time__week"]} 1`] = `
"SELECT
  COALESCE(subq_3.metric_time__week, subq_4.metric_time__week) AS metric_time__week
  , MAX(subq_3.completed_revenue) AS completed_revenue
  , MAX(subq_4.revenue) AS revenue
FROM (
  SELECT
    metric_time__week
    , SUM(completed_revenue) AS completed_revenue
  FROM (
    SELECT
      DATE_TRUNC('week', order_date) AS metric_time__week
      , status AS order__status
      , amount AS completed_revenue
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_1
  WHERE order__status = 'completed'
  GROUP BY
    metric_time__week
) subq_3
FULL OUTER JOIN (
  SELECT
    metric_time__week
    , SUM(revenue) AS revenue
  FROM (
    SELECT
      DATE_TRUNC('week', order_date) AS metric_time__week
      , amount AS revenue
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_2
  GROUP BY
    metric_time__week
) subq_4
ON subq_3.metric_time__week = subq_4.metric_time__week
GROUP BY
  COALESCE(subq_3.metric_time__week, subq_4.metric_time__week)"
`;

exports[`semantic query compiler > compiles example query {"metrics":["completion_rate"],"groupBy":["order__status"]} 1`] = `
"SELECT
  order__status
  , CAST(completed_orders AS DOUBLE PRECISION) / CAST(NULLIF(orders, 0) AS DOUBLE PRECISION) AS completion_rate
FROM (
  SELECT
    COALESCE(subq_3.order__status, subq_4.order__status) AS order__status
    , MAX(subq_3.completed_orders) AS completed_orders
    , MAX(subq_4.orders) AS orders
  FROM (
    SELECT
      order__status
      , SUM(completed_orders) AS completed_orders
    FROM (
      SELECT
        status AS order__status
        , 1 AS completed_orders
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_1
    WHERE order__status = 'completed'
    GROUP BY
      order__status
  ) subq_3
  FULL OUTER JOIN (
    SELECT
      order__status
      , SUM(orders) AS orders
    FROM (
      SELECT
        status AS order__status
        , 1 AS orders
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_2
    GROUP BY
      order__status
  ) subq_4
  ON subq_3.order__status = subq_4.order__status
  GROUP BY
    COALESCE(subq_3.order__status, subq_4.order__status)
) subq_5"
`;

exports[`semantic query compiler > compiles example query {"metrics":["cumulative_revenue"],"groupBy":["metric_time__month"],"orderBy":["metric_time__month"]} 1`] = `
"SELECT
  metric_time__month
  , cumulative_revenue
FROM (
  SELECT
    metric_time__month
    , FIRST_VALUE(cumulative_revenue) OVER (
      PARTITION BY metric_time__month
      ORDER BY metric_time__day
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS cumulative_revenue
  FROM (
    SELECT
      metric_time__day
      , metric_time__month
      , SUM(cumulative_revenue) AS cumulative_revenue
    FROM (
      SELECT
        time_spine_src.date_day AS metric_time__day
        , DATE_TRUNC('month', time_spine_src.date_day) AS metric_time__month
        , subq_1.cumulative_revenue
      FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
      INNER JOIN (
        SELECT
          DATE_TRUNC('day', order_date) AS __agg_day
          , amount AS cumulative_revenue
        FROM "jaffle_shop"."main"."orders" orders_src
      ) subq_1
      ON subq_1.__agg_day <= time_spine_src.date_day
    ) subq_2
    GROUP BY
      metric_time__day
      , metric_time__month
  ) subq_3
) subq_4
GROUP BY
  metric_time__month
  , cumulative_revenue
ORDER BY metric_time__month"
`;

exports[`semantic query compiler > compiles example query {"metrics":["customers","revenue"],"groupBy":["metric_time__year"]} 1`] = `
