ORDER BY metric_time__month DESC
LIMIT 12"
`;

exports[`semantic query compiler > compiles example query {"metrics":["revenue"],"groupBy":["customer__first_name"],"where":["{{ Dimension('customer__first_name') }} IS NOT NULL"],"orderBy":["-revenue"],"limit":10} 1`] = `
