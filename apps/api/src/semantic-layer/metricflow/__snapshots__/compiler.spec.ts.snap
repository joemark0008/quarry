exports[`semantic query compiler > compiles extended query {"metrics":["avg_amount","order_id_count","median_amount","p90_amount","coupon_orders","min_amount"],"groupBy":["order__status"]} 1`] = `
"SELECT
  COALESCE(subq_7.order__status, subq_8.order__status, subq_9.order__status, subq_10.order__status, subq_11.order__status, subq_12.order__status) AS order__status
  , MAX(subq_7.avg_amount) AS avg_amount
  , MAX(subq_8.order_id_count) AS order_id_count
  , MAX(subq_9.median_amount) AS median_amount
  , MAX(subq_10.p90_amount) AS p90_amount
  , MAX(subq_11.coupon_orders) AS coupon_orders
  , MAX(subq_12.min_amount) AS min_amount
FROM (
  SELECT
    order__status
    , AVG(avg_amount) AS avg_amount
  FROM (
    SELECT
      status AS order__status
      , amount AS avg_amount
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_1
  GROUP BY
    order__status
) subq_7
FULL OUTER JOIN (
  SELECT
    order__status
    , COUNT(order_id_count) AS order_id_count
  FROM (
    SELECT
      status AS order__status
      , order_id AS order_id_count
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_2
  GROUP BY
    order__status
) subq_8
ON subq_7.order__status = subq_8.order__status
FULL OUTER JOIN (
  SELECT
    order__status
    , PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY median_amount) AS median_amount
  FROM (
    SELECT
      status AS order__status
      , amount AS median_amount
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_3
  GROUP BY
    order__status
) subq_9
ON COALESCE(subq_7.order__status, subq_8.order__status) = subq_9.order__status
FULL OUTER JOIN (
  SELECT
    order__status
    , PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY p90_amount) AS p90_amount
  FROM (
    SELECT
      status AS order__status
      , amount AS p90_amount
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_4
  GROUP BY
    order__status
) subq_10
ON COALESCE(subq_7.order__status, subq_8.order__status, subq_9.order__status) = subq_10.order__status
FULL OUTER JOIN (
  SELECT
    order__status
    , SUM(CASE WHEN coupon_orders THEN 1 ELSE 0 END) AS coupon_orders
  FROM (
    SELECT
      status AS order__status
      , coupon_amount > 0 AS coupon_orders
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_5
  GROUP BY
    order__status
) subq_11
ON COALESCE(subq_7.order__status, subq_8.order__status, subq_9.order__status, subq_10.order__status) = subq_11.order__status
FULL OUTER JOIN (
  SELECT
    order__status
    , MIN(min_amount) AS min_amount
  FROM (
    SELECT
      status AS order__status
      , amount AS min_amount
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_6
  GROUP BY
    order__status
) subq_12
ON COALESCE(subq_7.order__status, subq_8.order__status, subq_9.order__status, subq_10.order__status, subq_11.order__status) = subq_12.order__status
GROUP BY
  COALESCE(subq_7.order__status, subq_8.order__status, subq_9.order__status, subq_10.order__status, subq_11.order__status, subq_12.order__status)"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["completed_share"],"groupBy":["customer__first_name"]} 1`] = `
"SELECT
  customer__first_name
  , done / total AS completed_share
FROM (
  SELECT
    COALESCE(subq_3.customer__first_name, subq_4.customer__first_name) AS customer__first_name
    , MAX(subq_3.done) AS done
    , MAX(subq_4.total) AS total
  FROM (
    SELECT
      customer__first_name
      , SUM(done) AS done
    FROM (
      SELECT
        customers_src.first_name AS customer__first_name
        , orders_src.status AS order__status
        , orders_src.amount AS done
      FROM "jaffle_shop"."main"."orders" orders_src
      LEFT OUTER JOIN (
        SELECT
          customer_id AS customer
          , first_name
        FROM "jaffle_shop"."main"."customers"
      ) customers_src
      ON orders_src.customer_id = customers_src.customer
    ) subq_1
    WHERE order__status = 'completed'
    GROUP BY
      customer__first_name
  ) subq_3
  FULL OUTER JOIN (
    SELECT
      customer__first_name
      , SUM(total) AS total
    FROM (
      SELECT
        customers_src.first_name AS customer__first_name
        , orders_src.amount AS total
      FROM "jaffle_shop"."main"."orders" orders_src
      LEFT OUTER JOIN (
        SELECT
          customer_id AS customer
          , first_name
        FROM "jaffle_shop"."main"."customers"
      ) customers_src
      ON orders_src.customer_id = customers_src.customer
    ) subq_2
    GROUP BY
      customer__first_name
  ) subq_4
  ON subq_3.customer__first_name = subq_4.customer__first_name
  GROUP BY
    COALESCE(subq_3.customer__first_name, subq_4.customer__first_name)
) subq_5"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["completion_rate","customers"],"groupBy":["metric_time__quarter"],"startTime":"2018-01-10","endTime":"2018-02-20"} 1`] = `
"SELECT
  COALESCE(subq_7.metric_time__quarter, subq_8.metric_time__quarter) AS metric_time__quarter
  , MAX(subq_7.completion_rate) AS completion_rate
  , MAX(subq_8.customers) AS customers
FROM (
  SELECT
    metric_time__quarter
    , CAST(completed_orders AS DOUBLE PRECISION) / CAST(NULLIF(orders, 0) AS DOUBLE PRECISION) AS completion_rate
  FROM (
    SELECT
      COALESCE(subq_3.metric_time__quarter, subq_4.metric_time__quarter) AS metric_time__quarter
      , MAX(subq_3.completed_orders) AS completed_orders
      , MAX(subq_4.orders) AS orders
    FROM (
      SELECT
        metric_time__quarter
        , SUM(completed_orders) AS completed_orders
      FROM (
        SELECT
          DATE_TRUNC('quarter', order_date) AS metric_time__quarter
          , status AS order__status
          , 1 AS completed_orders
        FROM "jaffle_shop"."main"."orders" orders_src
        WHERE DATE_TRUNC('day', order_date) BETWEEN '2018-01-01' AND '2018-03-31'
      ) subq_1
      WHERE order__status = 'completed'
      GROUP BY
        metric_time__quarter
    ) subq_3
    FULL OUTER JOIN (
      SELECT
        metric_time__quarter
        , SUM(orders) AS orders
      FROM (
        SELECT
          DATE_TRUNC('quarter', order_date) AS metric_time__quarter
          , 1 AS orders
        FROM "jaffle_shop"."main"."orders" orders_src
        WHERE DATE_TRUNC('day', order_date) BETWEEN '2018-01-01' AND '2018-03-31'
      ) subq_2
      GROUP BY
        metric_time__quarter
    ) subq_4
    ON subq_3.metric_time__quarter = subq_4.metric_time__quarter
    GROUP BY
      COALESCE(subq_3.metric_time__quarter, subq_4.metric_time__quarter)
  ) subq_5
) subq_7
FULL OUTER JOIN (
  SELECT
    metric_time__quarter
    , COUNT(DISTINCT customers) AS customers
  FROM (
    SELECT
      DATE_TRUNC('quarter', first_order) AS metric_time__quarter
      , customer_id AS customers
    FROM "jaffle_shop"."main"."customers" customers_src
    WHERE DATE_TRUNC('day', first_order) BETWEEN '2018-01-01' AND '2018-03-31'
  ) subq_6
  GROUP BY
    metric_time__quarter
) subq_8
ON subq_7.metric_time__quarter = subq_8.metric_time__quarter
GROUP BY
  COALESCE(subq_7.metric_time__quarter, subq_8.metric_time__quarter)"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["cumulative_revenue"],"groupBy":["metric_time__day"],"where":["{{ TimeDimension('metric_time', 'day') }} >= '2018-03-01'","{{ Dimension('order__status') }} = 'completed'"]} 1`] = `
"SELECT
  metric_time__day
  , SUM(cumulative_revenue) AS cumulative_revenue
FROM (
  SELECT
    time_spine_src.date_day AS metric_time__day
    , subq_1.order__status
    , subq_1.cumulative_revenue
  FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
  INNER JOIN (
    SELECT
      DATE_TRUNC('day', order_date) AS __agg_day
      , status AS order__status
      , amount AS cumulative_revenue
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_1
