WHERE (metric_time__day >= '2018-03-01') AND (order__status = 'completed')
GROUP BY
  metric_time__day"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["cumulative_revenue"],"groupBy":["metric_time__month","order__status"]} 1`] = `
