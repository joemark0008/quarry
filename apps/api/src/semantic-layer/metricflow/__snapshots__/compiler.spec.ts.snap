  customer__first_name
  , SUM(revenue) AS revenue
FROM (
  SELECT
    customers_src.first_name AS customer__first_name
    , orders_src.amount AS revenue
  FROM "jaffle_shop"."main"."orders" orders_src
  LEFT OUTER JOIN (
    SELECT
      customer_id AS customer
      , first_name
    FROM "jaffle_shop"."main"."customers"
  ) customers_src
  ON orders_src.customer_id = customers_src.customer
) subq_1
WHERE customer__first_name IS NOT NULL
GROUP BY
  customer__first_name
ORDER BY revenue DESC
LIMIT 10"
`;

exports[`semantic query compiler > compiles example query {"metrics":["revenue"],"groupBy":["customer__first_name"],"where":["{{ Metric('revenue', group_by=['customer']) }} > 100"]} 1`] = `
