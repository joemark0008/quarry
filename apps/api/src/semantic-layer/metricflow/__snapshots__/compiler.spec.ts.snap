exports[`semantic query compiler > compiles extended query {"metrics":["revenue_per_customer"],"groupBy":["metric_time__year"]} 1`] = `
"SELECT
  metric_time__year
  , revenue / customers AS revenue_per_customer
FROM (
  SELECT
    COALESCE(subq_3.metric_time__year, subq_4.metric_time__year) AS metric_time__year
    , MAX(subq_3.revenue) AS revenue
    , MAX(subq_4.customers) AS customers
  FROM (
    SELECT
      metric_time__year
      , SUM(revenue) AS revenue
    FROM (
      SELECT
        DATE_TRUNC('year', order_date) AS metric_time__year
        , amount AS revenue
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_1
    GROUP BY
      metric_time__year
  ) subq_3
  FULL OUTER JOIN (
    SELECT
      metric_time__year
      , COUNT(DISTINCT customers) AS customers
    FROM (
      SELECT
        DATE_TRUNC('year', first_order) AS metric_time__year
        , customer_id AS customers
      FROM "jaffle_shop"."main"."customers" customers_src
    ) subq_2
    GROUP BY
      metric_time__year
  ) subq_4
  ON subq_3.metric_time__year = subq_4.metric_time__year
  GROUP BY
    COALESCE(subq_3.metric_time__year, subq_4.metric_time__year)
) subq_5"
`;
