        SELECT
          DATE_TRUNC('day', order_date) AS __agg_day
          , amount AS cumulative_revenue
        FROM "jaffle_shop"."main"."orders" orders_src
      ) subq_1
      ON subq_1.__agg_day <= time_spine_src.date_day
      WHERE time_spine_src.date_day BETWEEN '2018-02-01' AND '2018-03-31'
    ) subq_2
    GROUP BY
      metric_time__day
      , metric_time__month
  ) subq_3
) subq_4
GROUP BY
  metric_time__month
  , cumulative_revenue"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["cumulative_revenue"]} 1`] = `
