exports[`semantic query compiler > compiles extended query {"metrics":["net_revenue"],"groupBy":["metric_time__month"]} 1`] = `
"SELECT
  metric_time__month
  , revenue - coupon_revenue AS net_revenue
FROM (
  SELECT
    COALESCE(subq_3.metric_time__month, subq_4.metric_time__month) AS metric_time__month
    , MAX(subq_3.revenue) AS revenue
    , MAX(subq_4.coupon_revenue) AS coupon_revenue
  FROM (
    SELECT
      metric_time__month
      , SUM(revenue) AS revenue
    FROM (
      SELECT
        DATE_TRUNC('month', order_date) AS metric_time__month
        , amount AS revenue
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_1
    GROUP BY
      metric_time__month
  ) subq_3
  FULL OUTER JOIN (
    SELECT
      metric_time__month
      , SUM(coupon_revenue) AS coupon_revenue
    FROM (
      SELECT
        DATE_TRUNC('month', order_date) AS metric_time__month
        , coupon_amount AS coupon_revenue
      FROM "jaffle_shop"."main"."orders" orders_src
    ) subq_2
    GROUP BY
      metric_time__month
  ) subq_4
  ON subq_3.metric_time__month = subq_4.metric_time__month
  GROUP BY
    COALESCE(subq_3.metric_time__month, subq_4.metric_time__month)
) subq_5"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["returned_revenue"],"groupBy":["metric_time__month"]} 1`] = `
"SELECT
  metric_time__month
  , COALESCE(SUM(returned_revenue), 0) AS returned_revenue
FROM (
  SELECT
    DATE_TRUNC('month', order_date) AS metric_time__month
    , status AS order__status
    , amount AS returned_revenue
  FROM "jaffle_shop"."main"."orders" orders_src
) subq_1
WHERE order__status = 'returned'
GROUP BY
  metric_time__month"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["revenue","customers"]} 1`] = `
"SELECT
  MAX(subq_3.revenue) AS revenue
  , MAX(subq_4.customers) AS customers
FROM (
  SELECT
    SUM(revenue) AS revenue
  FROM (
    SELECT
      amount AS revenue
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_1
) subq_3
CROSS JOIN (
