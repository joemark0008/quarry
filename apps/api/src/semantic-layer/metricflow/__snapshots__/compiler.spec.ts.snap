exports[`semantic query compiler > compiles extended query {"metrics":["revenue_7d"],"groupBy":["metric_time__day"]} 1`] = `
"SELECT
  metric_time__day
  , SUM(revenue_7d) AS revenue_7d
FROM (
  SELECT
    time_spine_src.date_day AS metric_time__day
    , subq_1.revenue_7d
  FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
  INNER JOIN (
    SELECT
      DATE_TRUNC('day', order_date) AS __agg_day
      , amount AS revenue_7d
    FROM "jaffle_shop"."main"."orders" orders_src
  ) subq_1
  ON (subq_1.__agg_day <= time_spine_src.date_day) AND (subq_1.__agg_day > time_spine_src.date_day - MAKE_INTERVAL(days => 7))
) subq_2
GROUP BY
  metric_time__day"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["revenue_7d"],"groupBy":["metric_time__month","customer__first_name"],"where":["{{ Dimension('customer__first_name') }} LIKE 'A%'"]} 1`] = `
"SELECT
  metric_time__month
  , customer__first_name
  , revenue_7d
FROM (
  SELECT
    metric_time__month
    , customer__first_name
    , FIRST_VALUE(revenue_7d) OVER (
      PARTITION BY metric_time__month, customer__first_name
      ORDER BY metric_time__day
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS revenue_7d
  FROM (
    SELECT
      metric_time__day
      , metric_time__month
      , customer__first_name
      , SUM(revenue_7d) AS revenue_7d
    FROM (
      SELECT
        time_spine_src.date_day AS metric_time__day
        , DATE_TRUNC('month', time_spine_src.date_day) AS metric_time__month
        , subq_1.customer__first_name
        , subq_1.revenue_7d
      FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
      INNER JOIN (
        SELECT
          DATE_TRUNC('day', orders_src.order_date) AS __agg_day
          , customers_src.first_name AS customer__first_name
          , orders_src.amount AS revenue_7d
        FROM "jaffle_shop"."main"."orders" orders_src
        LEFT OUTER JOIN (
          SELECT
            customer_id AS customer
            , first_name
          FROM "jaffle_shop"."main"."customers"
        ) customers_src
        ON orders_src.customer_id = customers_src.customer
      ) subq_1
      ON (subq_1.__agg_day <= time_spine_src.date_day) AND (subq_1.__agg_day > time_spine_src.date_day - MAKE_INTERVAL(days => 7))
    ) subq_2
    WHERE customer__first_name LIKE 'A%'
    GROUP BY
      metric_time__day
      , metric_time__month
      , customer__first_name
  ) subq_3
) subq_4
GROUP BY
  metric_time__month
  , customer__first_name
  , revenue_7d"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["revenue_cum_last","revenue_cum_avg"],"groupBy":["metric_time__month"]} 1`] = `
"SELECT
  COALESCE(subq_9.metric_time__month, subq_10.metric_time__month) AS metric_time__month
  , MAX(subq_9.revenue_cum_last) AS revenue_cum_last
  , MAX(subq_10.revenue_cum_avg) AS revenue_cum_avg
FROM (
  SELECT
    metric_time__month
    , revenue_cum_last
  FROM (
    SELECT
      metric_time__month
      , LAST_VALUE(revenue_cum_last) OVER (
        PARTITION BY metric_time__month
        ORDER BY metric_time__day
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
      ) AS revenue_cum_last
    FROM (
      SELECT
        metric_time__day
        , metric_time__month
        , SUM(revenue_cum_last) AS revenue_cum_last
      FROM (
        SELECT
          time_spine_src.date_day AS metric_time__day
          , DATE_TRUNC('month', time_spine_src.date_day) AS metric_time__month
          , subq_1.revenue_cum_last
        FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
        INNER JOIN (
          SELECT
            DATE_TRUNC('day', order_date) AS __agg_day
            , amount AS revenue_cum_last
          FROM "jaffle_shop"."main"."orders" orders_src
        ) subq_1
        ON subq_1.__agg_day <= time_spine_src.date_day
      ) subq_2
      GROUP BY
        metric_time__day
        , metric_time__month
    ) subq_3
  ) subq_4
  GROUP BY
    metric_time__month
    , revenue_cum_last
) subq_9
FULL OUTER JOIN (
  SELECT
    metric_time__month
    , revenue_cum_avg
  FROM (
    SELECT
      metric_time__month
      , AVG(revenue_cum_avg) OVER (PARTITION BY metric_time__month) AS revenue_cum_avg
    FROM (
      SELECT
        metric_time__day
        , metric_time__month
        , SUM(revenue_cum_avg) AS revenue_cum_avg
      FROM (
        SELECT
          time_spine_src.date_day AS metric_time__day
          , DATE_TRUNC('month', time_spine_src.date_day) AS metric_time__month
          , subq_5.revenue_cum_avg
        FROM "jaffle_shop"."main"."metricflow_time_spine" time_spine_src
        INNER JOIN (
          SELECT
            DATE_TRUNC('day', order_date) AS __agg_day
            , amount AS revenue_cum_avg
          FROM "jaffle_shop"."main"."orders" orders_src
        ) subq_5
        ON subq_5.__agg_day <= time_spine_src.date_day
      ) subq_6
      GROUP BY
        metric_time__day
        , metric_time__month
    ) subq_7
  ) subq_8
  GROUP BY
    metric_time__month
    , revenue_cum_avg
) subq_10
ON subq_9.metric_time__month = subq_10.metric_time__month
GROUP BY
  COALESCE(subq_9.metric_time__month, subq_10.metric_time__month)"
`;

