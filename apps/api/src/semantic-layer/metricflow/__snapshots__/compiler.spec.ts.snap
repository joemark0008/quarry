    FROM "jaffle_shop"."main"."customers" customers_src
  ) subq_2
) subq_4"
`;

exports[`semantic query compiler > compiles extended query {"metrics":["revenue","orders","average_order_value"],"groupBy":["order__status","customer__last_name"],"orderBy":["-revenue"],"limit":5} 1`] = `
"SELECT
  COALESCE(subq_8.order__status, subq_9.order__status, subq_10.order__status) AS order__status
  , COALESCE(subq_8.customer__last_name, subq_9.customer__last_name, subq_10.customer__last_name) AS customer__last_name
  , MAX(subq_8.revenue) AS revenue
  , MAX(subq_9.orders) AS orders
  , MAX(subq_10.average_order_value) AS average_order_value
FROM (
  SELECT
    order__status
    , customer__last_name
    , SUM(revenue) AS revenue
  FROM (
    SELECT
      orders_src.status AS order__status
      , customers_src.last_name AS customer__last_name
      , orders_src.amount AS revenue
    FROM "jaffle_shop"."main"."orders" orders_src
    LEFT OUTER JOIN (
      SELECT
        customer_id AS customer
        , last_name
      FROM "jaffle_shop"."main"."customers"
    ) customers_src
    ON orders_src.customer_id = customers_src.customer
  ) subq_1
  GROUP BY
    order__status
    , customer__last_name
) subq_8
FULL OUTER JOIN (
  SELECT
    order__status
    , customer__last_name
    , SUM(orders) AS orders
  FROM (
    SELECT
      orders_src.status AS order__status
      , customers_src.last_name AS customer__last_name
      , 1 AS orders
    FROM "jaffle_shop"."main"."orders" orders_src
    LEFT OUTER JOIN (
      SELECT
        customer_id AS customer
        , last_name
      FROM "jaffle_shop"."main"."customers"
    ) customers_src
    ON orders_src.customer_id = customers_src.customer
  ) subq_2
  GROUP BY
    order__status
    , customer__last_name
) subq_9
ON (subq_8.order__status = subq_9.order__status) AND (subq_8.customer__last_name = subq_9.customer__last_name)
FULL OUTER JOIN (
  SELECT
    order__status
    , customer__last_name
    , CAST(revenue AS DOUBLE PRECISION) / CAST(NULLIF(orders, 0) AS DOUBLE PRECISION) AS average_order_value
  FROM (
    SELECT
      COALESCE(subq_5.order__status, subq_6.order__status) AS order__status
      , COALESCE(subq_5.customer__last_name, subq_6.customer__last_name) AS customer__last_name
      , MAX(subq_5.revenue) AS revenue
      , MAX(subq_6.orders) AS orders
    FROM (
      SELECT
        order__status
        , customer__last_name
        , SUM(revenue) AS revenue
      FROM (
        SELECT
          orders_src.status AS order__status
          , customers_src.last_name AS customer__last_name
          , orders_src.amount AS revenue
        FROM "jaffle_shop"."main"."orders" orders_src
        LEFT OUTER JOIN (
          SELECT
            customer_id AS customer
            , last_name
          FROM "jaffle_shop"."main"."customers"
        ) customers_src
        ON orders_src.customer_id = customers_src.customer
      ) subq_3
      GROUP BY
        order__status
        , customer__last_name
    ) subq_5
    FULL OUTER JOIN (
      SELECT
        order__status
        , customer__last_name
        , SUM(orders) AS orders
      FROM (
        SELECT
          orders_src.status AS order__status
          , customers_src.last_name AS customer__last_name
          , 1 AS orders
        FROM "jaffle_shop"."main"."orders" orders_src
        LEFT OUTER JOIN (
          SELECT
            customer_id AS customer
            , last_name
          FROM "jaffle_shop"."main"."customers"
        ) customers_src
        ON orders_src.customer_id = customers_src.customer
      ) subq_4
      GROUP BY
        order__status
        , customer__last_name
    ) subq_6
    ON (subq_5.order__status = subq_6.order__status) AND (subq_5.customer__last_name = subq_6.customer__last_name)
    GROUP BY
      COALESCE(subq_5.order__status, subq_6.order__status)
      , COALESCE(subq_5.customer__last_name, subq_6.customer__last_name)
  ) subq_7
) subq_10
ON (COALESCE(subq_8.order__status, subq_9.order__status) = subq_10.order__status) AND (COALESCE(subq_8.customer__last_name, subq_9.customer__last_name) = subq_10.customer__last_name)
GROUP BY
  COALESCE(subq_8.order__status, subq_9.order__status, subq_10.order__status)
  , COALESCE(subq_8.customer__last_name, subq_9.customer__last_name, subq_10.customer__last_name)
ORDER BY revenue DESC
LIMIT 5"
`;

