generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Activity {
  id            String       @id @default(uuid())
  projectId     String       @map("project_id")
  userId        String?      @map("user_id")
  type          String
  status        String       @default("completed")
  trigger       String       @default("system")
  storyId       String?      @map("story_id")
  chatId        String?      @map("chat_id")
  sharedStoryId String?      @map("shared_story_id")
  sharedChatId  String?      @map("shared_chat_id")
  payload       Json?
  errorMessage  String?      @map("error_message")
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamp(6)
  chat          Chat?        @relation(fields: [chatId], references: [id], onUpdate: NoAction, map: "activity_chat_id_chat_id_fk")
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_project_id_project_id_fk")
  sharedChat    SharedChat?  @relation(fields: [sharedChatId], references: [id], onUpdate: NoAction, map: "activity_shared_chat_id_shared_chat_id_fk")
  sharedStory   SharedStory? @relation(fields: [sharedStoryId], references: [id], onUpdate: NoAction, map: "activity_shared_story_id_shared_story_id_fk")
  story         Story?       @relation(fields: [storyId], references: [id], onUpdate: NoAction, map: "activity_story_id_story_id_fk")
  user          User?        @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "activity_user_id_user_id_fk")

  @@index([chatId], map: "activity_chatId_idx")
  @@index([projectId], map: "activity_projectId_idx")
  @@index([sharedChatId], map: "activity_sharedChatId_idx")
  @@index([sharedStoryId], map: "activity_sharedStoryId_idx")
  @@index([startedAt], map: "activity_startedAt_idx")
  @@index([storyId], map: "activity_storyId_idx")
  @@index([type])
  @@index([userId], map: "activity_userId_idx")
  @@map("activity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AnalyticsEvent {
  id            String       @id @default(uuid())
  projectId     String       @map("project_id")
  type          String
  assetType     String       @map("asset_type")
  actorUserId   String?      @map("actor_user_id")
  chatId        String?      @map("chat_id")
  storyId       String?      @map("story_id")
  sharedChatId  String?      @map("shared_chat_id")
  sharedStoryId String?      @map("shared_story_id")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  user          User?        @relation(fields: [actorUserId], references: [id], onUpdate: NoAction, map: "analytics_event_actor_user_id_user_id_fk")
  chat          Chat?        @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_event_chat_id_chat_id_fk")
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_event_project_id_project_id_fk")
  sharedChat    SharedChat?  @relation(fields: [sharedChatId], references: [id], onUpdate: NoAction, map: "analytics_event_shared_chat_id_shared_chat_id_fk")
  sharedStory   SharedStory? @relation(fields: [sharedStoryId], references: [id], onUpdate: NoAction, map: "analytics_event_shared_story_id_shared_story_id_fk")
  story         Story?       @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_event_story_id_story_id_fk")

  @@index([actorUserId], map: "analytics_event_actorUserId_idx")
  @@index([chatId], map: "analytics_event_chatId_idx")
  @@index([projectId], map: "analytics_event_projectId_idx")
  @@index([projectId, type, assetType, storyId], map: "analytics_event_project_type_asset_story_idx")
  @@index([sharedChatId], map: "analytics_event_sharedChatId_idx")
  @@index([sharedStoryId], map: "analytics_event_sharedStoryId_idx")
  @@index([storyId], map: "analytics_event_storyId_idx")
  @@index([type, createdAt], map: "analytics_event_type_createdAt_idx")
  @@map("analytics_event")
}

model ApiKey {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  name         String
  keyHash      String       @unique(map: "api_key_key_hash_unique") @map("key_hash")
  keyPrefix    String       @map("key_prefix")
  createdBy    String       @map("created_by")
  lastUsedAt   DateTime?    @map("last_used_at") @db.Timestamp(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  user         User         @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_key_created_by_user_id_fk")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_key_org_id_organization_id_fk")

  @@index([orgId], map: "api_key_orgId_idx")
  @@map("api_key")
}

model Automation {
  id                  String          @id @default(uuid())
  projectId           String          @map("project_id")
  userId              String          @map("user_id")
  title               String
  prompt              String
  scheduleDescription String?         @map("schedule_description")
  timezone            String?
  modelProvider       String?         @map("model_provider")
  modelId             String?         @map("model_id")
  mcpEnabled          Boolean         @default(true) @map("mcp_enabled")
  mcpServers          Json?           @map("mcp_servers")
  integrations        Json            @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  webhookEnabled      Boolean         @default(false) @map("webhook_enabled")
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "automation_project_id_project_id_fk")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "automation_user_id_user_id_fk")
  automationRuns      AutomationRun[]

  @@index([projectId], map: "automation_projectId_idx")
  @@index([userId], map: "automation_userId_idx")
  @@map("automation")
}

model AutomationRun {
  id                 String     @id @default(uuid())
  automationId       String     @map("automation_id")
  chatId             String?    @map("chat_id")
  status             String     @default("running")
  startedAt          DateTime   @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt        DateTime?  @map("completed_at") @db.Timestamp(6)
  errorMessage       String?    @map("error_message")
  integrationResults Json       @default("[]") @map("integration_results")
  readAt             DateTime?  @map("read_at") @db.Timestamp(6)
  automation         Automation @relation(fields: [automationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "automation_run_automation_id_automation_id_fk")
  chat               Chat?      @relation(fields: [chatId], references: [id], onUpdate: NoAction, map: "automation_run_chat_id_chat_id_fk")

  @@index([automationId], map: "automation_run_automationId_idx")
  @@index([chatId], map: "automation_run_chatId_idx")
  @@index([status])
  @@map("automation_run")
}

model BudgetNotification {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  provider    String
  scope       String
  periodStart DateTime @map("period_start") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budget_notification_project_id_project_id_fk")

  @@unique([projectId, provider, scope, periodStart], map: "budget_notification_project_provider_scope_period")
  @@index([projectId], map: "budget_notification_projectId_idx")
  @@map("budget_notification")
}

model ChartImage {
  id         String   @id @default(uuid())
  toolCallId String   @unique(map: "chart_image_tool_call_id_unique") @map("tool_call_id")
  data       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("chart_image")
}

model Chat {
  id                        String                     @id @default(uuid())
  userId                    String                     @map("user_id")
  title                     String                     @default("New Conversation")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  slackThreadId             String?                    @map("slack_thread_id")
  projectId                 String                     @map("project_id")
  teamsThreadId             String?                    @map("teams_thread_id")
  isStarred                 Boolean                    @default(false) @map("is_starred")
  telegramThreadId          String?                    @map("telegram_thread_id")
  whatsappThreadId          String?                    @map("whatsapp_thread_id")
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamp(6)
  forkMetadata              Json?                      @map("fork_metadata")
  mattermostThreadId        String?                    @map("mattermost_thread_id")
  discordThreadId           String?                    @map("discord_thread_id")
  activities                Activity[]
  analyticsEvents           AnalyticsEvent[]
  automationRuns            AutomationRun[]
  project                   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_project_id_project_id_fk")
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_user_id_user_id_fk")
  chatMessages              ChatMessage[]
  contextRecommendationRuns ContextRecommendationRun[]
  llmInferences             LlmInference[]
  memories                  Memory[]
  sharedChat                SharedChat?
  stories                   Story[]

  @@index([discordThreadId], map: "chat_discord_thread_idx")
  @@index([mattermostThreadId], map: "chat_mattermost_thread_idx")
  @@index([projectId], map: "chat_projectId_idx")
  @@index([slackThreadId], map: "chat_slack_thread_idx")
  @@index([teamsThreadId], map: "chat_teams_thread_idx")
  @@index([telegramThreadId], map: "chat_telegram_thread_idx")
  @@index([userId], map: "chat_userId_idx")
  @@index([whatsappThreadId], map: "chat_whatsapp_thread_idx")
  @@map("chat")
}

model ChatMessage {
  id                                   String                                @id @default(uuid())
  chatId                               String                                @map("chat_id")
  role                                 String
  createdAt                            DateTime                              @default(now()) @map("created_at") @db.Timestamp(6)
  stopReason                           String?                               @map("stop_reason")
  errorMessage                         String?                               @map("error_message")
  llmProvider                          String?                               @map("llm_provider")
  llmModelId                           String?                               @map("llm_model_id")
  inputTotalTokens                     Int?                                  @map("input_total_tokens")
  inputNoCacheTokens                   Int?                                  @map("input_no_cache_tokens")
  inputCacheReadTokens                 Int?                                  @map("input_cache_read_tokens")
  inputCacheWriteTokens                Int?                                  @map("input_cache_write_tokens")
  outputTotalTokens                    Int?                                  @map("output_total_tokens")
  outputTextTokens                     Int?                                  @map("output_text_tokens")
  outputReasoningTokens                Int?                                  @map("output_reasoning_tokens")
  totalTokens                          Int?                                  @map("total_tokens")
  supersededAt                         DateTime?                             @map("superseded_at") @db.Timestamp(6)
  source                               String?
  isForked                             Boolean?
  citation                             Json?
  versionGroupId                       String?                               @map("version_group_id")
  senderUserId                         String?                               @map("sender_user_id")
  discordMessageId                     String?                               @map("discord_message_id")
  chat                                 Chat                                  @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_message_chat_id_chat_id_fk")
  user                                 User?                                 @relation(fields: [senderUserId], references: [id], onUpdate: NoAction, map: "chat_message_sender_user_id_user_id_fk")
  contextRecommendationLinkedFeedbacks ContextRecommendationLinkedFeedback[]
  messageFeedback                      MessageFeedback?
  messageParts                         MessagePart[]

  @@index([chatId, createdAt], map: "chat_message_chatId_createdAt_idx")
  @@index([chatId], map: "chat_message_chatId_idx")
  @@index([createdAt], map: "chat_message_createdAt_idx")
  @@index([discordMessageId], map: "chat_message_discordMessageId_idx")
  @@index([senderUserId], map: "chat_message_senderUserId_idx")
  @@index([versionGroupId], map: "chat_message_versionGroupId_idx")
  @@map("chat_message")
}

