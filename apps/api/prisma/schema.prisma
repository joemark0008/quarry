model ContextRecommendationLinkedFeedback {
  recommendationId      String                @map("recommendation_id")
  messageId             String                @map("message_id")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  chatMessage           ChatMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "context_recommendation_linked_feedback_message_id_chat_message_")
  contextRecommendation ContextRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "context_recommendation_linked_feedback_recommendation_id_contex")

  @@id([recommendationId, messageId], map: "context_recommendation_linked_feedback_recommendation_id_messag")
  @@index([messageId])
  @@map("context_recommendation_linked_feedback")
}

model ContextRecommendationRun {
  id                     String                  @id @default(uuid())
  projectId              String                  @map("project_id")
  chatId                 String?                 @map("chat_id")
  trigger                String                  @default("schedule")
  status                 String                  @default("running")
  windowStart            DateTime?               @map("window_start") @db.Timestamp(6)
  windowEnd              DateTime?               @map("window_end") @db.Timestamp(6)
  startedAt              DateTime                @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt            DateTime?               @map("completed_at") @db.Timestamp(6)
  errorMessage           String?                 @map("error_message")
  llmProvider            String?                 @map("llm_provider")
  llmModelId             String?                 @map("llm_model_id")
  inputTotalTokens       Int?                    @map("input_total_tokens")
  outputTotalTokens      Int?                    @map("output_total_tokens")
  totalTokens            Int?                    @map("total_tokens")
  contextRecommendations ContextRecommendation[]
  chat                   Chat?                   @relation(fields: [chatId], references: [id], onUpdate: NoAction, map: "context_recommendation_run_chat_id_chat_id_fk")
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "context_recommendation_run_project_id_project_id_fk")

  @@unique([id, projectId], map: "context_recommendation_run_id_project_unique")
  @@index([chatId], map: "context_recommendation_run_chatId_idx")
  @@index([projectId], map: "context_recommendation_run_projectId_idx")
  @@index([status])
  @@map("context_recommendation_run")
}

