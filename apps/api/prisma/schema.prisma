  impact                               Json?
  insights                             Json                                  @default("[]")
  title                                String
  summary                              String
  suggestedAction                      String                                @map("suggested_action")
  fixKind                              String?                               @map("fix_kind")
  proposedEdits                        Json?                                 @map("proposed_edits")
  fixGuidance                          String?                               @map("fix_guidance")
  fixPrompt                            String?                               @map("fix_prompt")
  prUrl                                String?                               @map("pr_url")
  prBranch                             String?                               @map("pr_branch")
  prCreatedAt                          DateTime?                             @map("pr_created_at") @db.Timestamp(6)
  llmProvider                          String?                               @map("llm_provider")
  llmModelId                           String?                               @map("llm_model_id")
  firstSeenAt                          DateTime                              @default(now()) @map("first_seen_at") @db.Timestamp(6)
  lastSeenAt                           DateTime                              @default(now()) @map("last_seen_at") @db.Timestamp(6)
  occurrenceCount                      Int                                   @default(1) @map("occurrence_count")
  statusChangedAt                      DateTime?                             @map("status_changed_at") @db.Timestamp(6)
  statusChangedBy                      String?                               @map("status_changed_by")
  createdAt                            DateTime                              @default(now()) @map("created_at") @db.Timestamp(6)
  fixTarget                            String?                               @map("fix_target")
  category                             String?
  rootCause                            String?                               @map("root_cause")
  rootCauseKind                        String?                               @map("root_cause_kind")
  project                              Project                               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "context_recommendation_project_id_project_id_fk")
  contextRecommendationRun             ContextRecommendationRun              @relation(fields: [runId, projectId], references: [id, projectId], onDelete: NoAction, onUpdate: NoAction, map: "context_recommendation_run_fk")
  user                                 User?                                 @relation(fields: [statusChangedBy], references: [id], onUpdate: NoAction, map: "context_recommendation_status_changed_by_user_id_fk")
  contextRecommendationLinkedFeedbacks ContextRecommendationLinkedFeedback[]

  @@unique([projectId, fingerprint], map: "context_recommendation_project_fingerprint_unique")
  @@index([projectId, status], map: "context_recommendation_projectId_status_idx")
  @@index([runId], map: "context_recommendation_runId_idx")
  @@map("context_recommendation")
}

model ContextRecommendationConfig {
  projectId                      String   @id @map("project_id")
  frequency                      String?
  customSystemPromptInstructions String?  @map("custom_system_prompt_instructions")
  repoFullName                   String?  @map("repo_full_name")
  autoCreatePrs                  Boolean? @map("auto_create_prs")
