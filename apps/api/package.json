{
	"name": "@quarry/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
		"start": "node --import @swc-node/register/esm-register src/main.ts",
		"lint": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:reset": "prisma migrate reset --force",
		"db:seed": "node --import @swc-node/register/esm-register prisma/seed.ts",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@nao/shared": "*",
		"@nestjs/apollo": "^13.4.5",
		"@nestjs/common": "^11.1.0",
		"@nestjs/core": "^11.1.0",
		"@nestjs/graphql": "^13.4.5",
		"@nestjs/platform-express": "^11.1.0",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"better-auth": "~1.6.30",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"dataloader": "^2.2.3",
		"dotenv": "^17.2.3",
		"graphql": "^16.11.0",
		"pg": "^8.16.3",
		"pg-boss": "^12.38.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.0",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.13.5",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.0",
		"@types/pg": "^8.16.0",
		"@types/supertest": "^6.0.3",
		"prisma": "7.10.1",
		"supertest": "^7.1.4",
		"unplugin-swc": "^1.5.7",
		"vitest": "^4.0.16"
	}
}
