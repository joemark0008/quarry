{
	"include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "vite.config.js"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "ES2024.String", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun-types"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		/* apps/api sources reached through @quarry/api/* use Nest decorators */
		"experimentalDecorators": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@quarry/shared": ["../shared/src/index.ts"],
			"@quarry/shared/*": ["../shared/src/*"],
			// apps/api's types, and its few pure modules the frontend shares (vite.config.ts aliases them too).
			"@quarry/api/*": ["../api/src/*"],
			"zod": ["../../node_modules/zod"],
			"zod/*": ["../../node_modules/zod/*"],
			"ai": ["../../node_modules/ai"]
		}
	}
}
