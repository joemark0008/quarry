{
	"include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "vite.config.js"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "ES2024.String", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun-types"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			// Upstream sources reached through @nao/shared/backend/* must see quarry's copies, not fork-reference's.
			"@nao/shared": ["../shared/src/index.ts"],
			"@nao/shared/*": ["../shared/src/*"],
			"zod": ["../../node_modules/zod"],
			"zod/*": ["../../node_modules/zod/*"],
			"ai": ["../../node_modules/ai"]
		}
	}
}
